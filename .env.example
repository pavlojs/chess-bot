# ─────────────────────────────────────────────
# REQUIRED
# ─────────────────────────────────────────────

# Lichess API token of the bot account. The only scope it needs is bot:play.
# Create one at: https://lichess.org/account/oauth/token
TOKEN="your_lichess_token_here"

# ─────────────────────────────────────────────
# STOCKFISH SETUP (optional)
# ─────────────────────────────────────────────

# Download and install the latest Stockfish on startup, and replace it when a
# new release appears (default: false). It writes to /usr/local/bin and asks for
# sudo when it has to. The container image never does this: its engine is part
# of the image.
# AUTO_UPDATE_STOCKFISH=false

# Path to a Stockfish binary to use as it is (auto-detected if not set)
# STOCKFISH_PATH="/usr/local/bin/stockfish"

# Directory with Syzygy tablebase files; used when it holds any (default: ./syzygy)
# SF_SYZYGY_PATH=./syzygy

# ─────────────────────────────────────────────
# LOG FILE (optional)
# ─────────────────────────────────────────────
#
# logs/axiom_bot.log records everything from DEBUG up and is rotated: one file
# of at most LOG_FILE_MAX_MB and LOG_FILE_BACKUPS older ones, so the directory
# never holds more than MAX_MB x (BACKUPS + 1), 60 MB with the defaults.

# Size of one log file in MB before it is rotated (default: 10)
# LOG_FILE_MAX_MB=10

# Number of rotated files kept beside the current one (default: 5)
# LOG_FILE_BACKUPS=5

# ─────────────────────────────────────────────
# ENGINE PERFORMANCE (optional)
# ─────────────────────────────────────────────

# Each game runs an engine of its own, so the two values below are per game:
# with MAX_CONCURRENT_GAMES=2 the bot can use twice the threads and twice the hash.

# CPU threads for Stockfish (default: 4)
# SF_THREADS=4

# Hash table size in MB (default: 2048 = 2 GB)
# SF_HASH=2048

# Network latency compensation in ms (default: 30)
# SF_MOVE_OVERHEAD=30

# Base thinking time per move in ms — used for weak opponents and fallback (default: 3000)
# STOCKFISH_TIME=3000

# Clock-aware movetime safety — fraction of (remaining/moves_left + inc) to use as hard cap
# Lower = more conservative, less risk of outoftime (default: 0.8)
# MOVETIME_CLOCK_SAFETY=0.8

# Hard floor for any calculated movetime in ms — bot always thinks at least this long (default: 50)
# MOVETIME_MIN_MS=50

# Baseline moves-to-go estimate used in the clock budget formula (default: 40)
# Reduced dynamically as the game progresses
# MOVETIME_ESTIMATED_MOVES=40

# Minimum moves-to-go value in denominator — prevents over-spending in long endgames (default: 10)
# MOVETIME_MIN_MOVES_LEFT=10

# ─────────────────────────────────────────────
# DYNAMIC STRENGTH SYSTEM (optional)
# ─────────────────────────────────────────────
#
# Below FULL_STRENGTH_THRESHOLD the engine's own strength limit (UCI_LimitStrength)
# is on, set to opponent_rating + STRENGTH_ADVANTAGE, never under 1320 (the
# lowest Stockfish accepts) and never over 2850. Those games are searched with
# a fixed time per move, so the bot answers quickly.
#
# Tiers:
#   < LIMIT_STRENGTH_THRESHOLD   → strength limit, 40% of STOCKFISH_TIME per move
#   LIMIT – FULL threshold       → strength limit, 40-95% of STOCKFISH_TIME per move
#   >= FULL_STRENGTH_THRESHOLD   → full strength, searched on the game clock
#
# Enable/disable the entire dynamic strength system (default: true)
# DYNAMIC_STRENGTH=true

# Boundary between minimal-time zone and scaled-time zone (default: 1800)
# Below: 40% movetime.  Between this and FULL_STRENGTH_THRESHOLD: 40-95% scaled.
# LIMIT_STRENGTH_THRESHOLD=1800

# At or above this rating: UCI_LimitStrength OFF, native clocks, full engine power (default: 2800)
# FULL_STRENGTH_THRESHOLD=2800

# ELO bonus: bot plays at opponent_rating + bonus for all below FULL_STRENGTH_THRESHOLD (default: 100)
# STRENGTH_ADVANTAGE=100

# ─────────────────────────────────────────────
# MOVE PREDICTION / ANALYSIS (optional)
# ─────────────────────────────────────────────

# Show Stockfish's planned continuation in logs (default: true)
# No extra engine call — extracted from the normal search info line at zero cost
# ENABLE_MOVE_PREDICTION=true

# Number of half-moves to display in the predicted line (default: 10)
# PREDICTION_DEPTH=10

# If prediction is active and the predicted evaluation for the bot is worse
# than this threshold (in centipawns), the bot will attempt a recovery search
# (longer movetime + temporary ELO boost)
# PREDICTION_RECOVER_THRESHOLD=400

# ELO boost added to UCI_LimitStrength cap during recovery search.
# Applied on top of the already-boosted target ELO (opponent + STRENGTH_ADVANTAGE),
# so the full recovery cap is: opponent_rating + STRENGTH_ADVANTAGE + PREDICTION_RECOVER_ELO_BOOST.
# Keeps the game potentially winnable for the opponent (not full power),
# but gives slightly stronger defensive play than the normal level.
# Default: 200 — e.g. opponent 1500 + STRENGTH_ADVANTAGE 100 = cap 1600 → 1800 during recovery.
# PREDICTION_RECOVER_ELO_BOOST=200

# ─────────────────────────────────────────────
# CHALLENGES THE BOT ACCEPTS (optional)
# ─────────────────────────────────────────────

# Rating range of the challengers the bot accepts, at the speed of the challenge
# (defaults: 1320–2800). Anyone outside it is declined.
#   Lowest value: 400. Highest value: 4000. That is the range of Lichess ratings.
#   MIN_RATING may not be above MAX_RATING; the bot refuses to start otherwise.
#   Below 1320 the bot cannot play any weaker: 1320 is the lowest strength
#   Stockfish can be set to, so such a challenger meets a far stronger bot.
# MIN_RATING=1320
# MAX_RATING=2800

# Speeds the bot accepts, comma-separated (default: all four). A challenge at
# another speed is declined as too fast or too slow. Lichess takes a game's
# length to be its initial time plus 40 increments:
#   bullet      under 3 minutes         1+0, 2+1
#   blitz       3 to under 8 minutes    3+0, 3+2, 5+3
#   rapid       8 to under 25 minutes   10+0, 10+5, 15+10
#   classical   25 minutes and more     30+0, 20+10
#   Fewest: one speed. Most: all four. Left empty, the bot accepts no challenge.
#   Any other word stops the bot at startup.
# TIME_CONTROL=bullet,blitz,rapid,classical

# ─────────────────────────────────────────────
# AUTO-CHALLENGE (optional)
# ─────────────────────────────────────────────

# Automatically challenge other bots when idle (default: true)
# ENABLE_AUTO_CHALLENGE=true

# Maximum challenges the bot creates per hour (default: 5). Every attempt
# counts, also one that Lichess or the other bot refuses.
# MAX_CHALLENGES_PER_HOUR=5

# Maximum challenges the bot creates in any 24 hours (default: 180). Lichess
# allows an account 200 a day and answers the rest with HTTP 429, so keep this
# below 200. It only comes into play above 7 challenges an hour.
# MAX_CHALLENGES_PER_DAY=180

# Rating range of the bots to challenge (defaults: 1500–2900). The rating
# compared is the one for the speed of the game being offered.
# CHALLENGE_MIN_RATING=1500
# CHALLENGE_MAX_RATING=2900

# Idle poll interval when no challenge is pending, in seconds (default: 60)
# CHALLENGE_CHECK_INTERVAL=60

# ─────────────────────────────────────────────
# GAME RESILIENCE (optional)
# ─────────────────────────────────────────────

# How long (in seconds) a game stream may be silent before the bot asks Lichess
# about the game. A game that has ended closes its thread; a game under way is
# left alone however long the opponent thinks.  (default: 60)
# GAME_WATCHDOG_INTERVAL=60

# How long (in seconds) a game may go without both sides having made their
# first move before the bot aborts it. Aborting at that stage costs neither
# side anything.  (default: 600 = 10 min)
# GAME_WATCHDOG_ABORT_TIMEOUT=600

# Maximum number of games the bot plays at the same time. A challenge that
# arrives while all of them are taken is declined. Each game runs its own
# engine with SF_THREADS and SF_HASH.  (default: 2)
# MAX_CONCURRENT_GAMES=2

# ─────────────────────────────────────────────
# MONITORING (optional)
# ─────────────────────────────────────────────

# Address of an Uptime Kuma monitor of the type "Push", as Kuma shows it, for
# example https://kuma.example.org/api/push/AbCdEf123?status=up&msg=OK&ping=
# (default: empty, nothing is reported). When set, the bot reports to it every
# KUMA_PUSH_INTERVAL seconds: "up" while Lichess is being heard from, "down"
# once it has been silent for a minute. A bot that has stopped or hangs
# reports nothing, and Kuma alerts when the reports stop coming. The address
# contains the monitor's token: keep it out of anything public.
# KUMA_PUSH_URL=

# Seconds between two reports (default: 60). Minimum: 10. No maximum.
# In Kuma, set the monitor's "Heartbeat Interval" to a little over twice this
# number (130 for the default) and leave "Retries" at 0. One lost report or a
# restart of the bot then raises no alarm, a bot that has stopped raises one
# within that interval, and a "down" report raises one at once.
# KUMA_PUSH_INTERVAL=60
